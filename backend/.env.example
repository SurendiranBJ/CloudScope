# AWS Configuration
AWS_PROFILE=identityscope-scanner
AWS_DEFAULT_REGION=ap-south-1
# Comma-separated list of target AWS regions to scan.
# Defaults to the AWS session's default region (e.g. session.region_name) if not set.
# Example: SCAN_REGIONS=us-east-1,ap-south-1
SCAN_REGIONS=

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Redis Caching (Optional placeholder)
REDIS_HOST=localhost
REDIS_PORT=6379

# Service Settings
BACKEND_PORT=8000
SCAN_INTERVAL_MINUTES=5
LOG_LEVEL=INFO

# CORS Allowed Origins
# Comma-separated list of origins permitted to call the API.
# Do NOT add '*' here — use explicit origins only.
# Example for a deployed frontend:
#   CORS_ORIGINS=https://cloudscope.example.com,http://localhost:5173
# Defaults to http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
