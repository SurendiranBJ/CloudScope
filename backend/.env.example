# AWS Configuration
AWS_PROFILE=identityscope-scanner
AWS_DEFAULT_REGION=ap-south-1

# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Redis Caching (Optional placeholder)
REDIS_HOST=localhost
REDIS_PORT=6379

# Service Settings
BACKEND_PORT=8000
SCAN_INTERVAL_MINUTES=5
LOG_LEVEL=INFO
