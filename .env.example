# ==============================================================================
# CloudScope Environment Configuration Template
# Copy this file to .env and configure your secrets before starting the application:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Security & Authentication (MANDATORY IN PRODUCTION)
# ------------------------------------------------------------------------------
# DEV_AUTH_MODE: Set to 'false' for production deployments to enforce strict JWT/RBAC.
# When set to false, all requests require valid JWT bearer tokens.
DEV_AUTH_MODE=false

# JWT_SECRET: Secret key used to sign and verify HS256 JWT access tokens.
# MUST BE REPLACED IN PRODUCTION. Must be at least 32 characters in production. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-secure-random-secret-at-least-32-chars!

# JWT_ALGORITHM: Token signature algorithm (default: HS256)
JWT_ALGORITHM=HS256

# Production JWT validation requires the exact issuer and audience claims.
# MUST BE REPLACED IN PRODUCTION. Example placeholders will be rejected.
OIDC_ISSUER_URL=https://replace-with-your-issuer-url.com
OIDC_AUDIENCE=replace-with-your-audience

# ------------------------------------------------------------------------------
# Neo4j Graph Database
# ------------------------------------------------------------------------------
NEO4J_USER=neo4j
# Strong database password for Neo4j. Required when starting containers.
# MUST BE REPLACED IN PRODUCTION. Example placeholders will be rejected.
NEO4J_PASSWORD=replace-with-a-secure-neo4j-password

# Internal Neo4j URI (defaults to the docker-compose internal service)
NEO4J_URI=bolt://neo4j:7687

# ------------------------------------------------------------------------------
# Redis Distributed Cache & Lock
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# AWS Credentials & Scanning
# ------------------------------------------------------------------------------
# Path to host AWS credentials directory mounted read-only into backend container.
# Linux / macOS: ~/.aws
# Windows Docker Desktop: C:\Users\<Username>\.aws
AWS_CREDENTIALS_DIR=~/.aws

# Named profile to use from credentials/config files (default: default)
AWS_PROFILE=default

# Primary default AWS region
AWS_DEFAULT_REGION=us-east-1

# Optional comma-separated list of regions to scan (empty defaults to AWS default region)
# SCAN_REGIONS=us-east-1,us-west-2,ap-south-1

# ------------------------------------------------------------------------------
# AI Security Copilot (Google Gemini) - Optional
# ------------------------------------------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_MAX_OUTPUT_TOKENS=1200
AI_TEMPERATURE=0.2
AI_CONTEXT_MAX_CHARS=24000
AI_TIMEOUT_SECONDS=30

# ------------------------------------------------------------------------------
# Observability & Deployment Settings
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
ENVIRONMENT=production

# Image tag used by compose.release.yaml (e.g. v1.0.0 for pinned releases, or sura-latest for rolling build)
IMAGE_TAG=v1.0.0

# Optional overrides for custom container registries
# BACKEND_IMAGE=ghcr.io/surendiranj/cloudscope-backend
# FRONTEND_IMAGE=ghcr.io/surendiranj/cloudscope-frontend
