# ==============================================================================
# CloudScope Environment Configuration Template
# ==============================================================================

# AWS Authentication & Region Configuration
AWS_PROFILE=identityscope-scanner
AWS_DEFAULT_REGION=ap-south-1
# Comma-separated list of target AWS regions to scan.
# Leave empty to default to AWS session default region (or use ALL_REGIONS mode)
# Example: SCAN_REGIONS=us-east-1,ap-south-1
SCAN_REGIONS=

# Neo4j Graph Database Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Redis Snapshot Cache
REDIS_HOST=localhost
REDIS_PORT=6379

# Service Orchestration & Observability
BACKEND_PORT=8000
SCAN_INTERVAL_MINUTES=5
LOG_LEVEL=INFO

# CORS Allowed Origins
# Defaults to http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# AI Security Copilot (Gemini)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_MAX_OUTPUT_TOKENS=1200
AI_TEMPERATURE=0.2
AI_CONTEXT_MAX_CHARS=24000
AI_TIMEOUT_SECONDS=30
